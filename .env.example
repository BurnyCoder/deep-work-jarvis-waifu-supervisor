# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored so secrets never reach version control.
# Loaded at startup by python-dotenv: https://pypi.org/project/python-dotenv/

# --- OpenAI API (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-key-here

# Every Responses API text/image workload uses flagship GPT-5.6 Sol with
# explicit xhigh reasoning by default. Each workload remains independently
# overridable for local latency, cost, or model-access constraints.
# https://developers.openai.com/api/docs/guides/latest-model
VISION_MODEL=gpt-5.6-sol
PROGRESS_REASONING_EFFORT=xhigh
AGENT_VISION_MODEL=gpt-5.6-sol
AGENT_REASONING_EFFORT=xhigh
TEXT_MODEL=gpt-5.6-sol
TEXT_REASONING_EFFORT=xhigh

# --- Text-to-speech ---
# "openai" = natural voice via OpenAI TTS API (needs internet, costs money)
# "pyttsx3" = offline Windows SAPI5 voice (free, robotic)
TTS_ENGINE=openai
# Sol cannot replace this dedicated audio-output model because Sol returns text.
# https://developers.openai.com/api/docs/models/gpt-5.6-sol
# OpenAI TTS model/voice: https://developers.openai.com/api/docs/guides/text-to-speech
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# --- Monitoring cadence ---
# Seconds between captures (default 300 = 5 minutes)
CAPTURE_INTERVAL_S=300
# Number of recent captures compared at every five-minute evaluation
PROGRESS_WINDOW_CAPTURES=5
# Seconds between distraction-app kill sweeps
KILL_INTERVAL_S=3
# Agentic mode: seconds between "is my AI agent still working?" vision polls
AGENT_CHECK_INTERVAL_S=60

# --- Break allowances ---
# Daily cap on social-media break minutes
DAILY_SOCIAL_CAP_MIN=120

# --- Web UI ---
UI_PORT=5000
