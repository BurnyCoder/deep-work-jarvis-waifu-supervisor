# Copy this file to `.env` and fill in your real values.
# The repository's `.gitignore` excludes `.env`, but review staged files.
# Never force-add it or any credential.
# Loaded at startup by python-dotenv: https://bbc2.github.io/python-dotenv/

# --- OpenAI API (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-key-here

# Every Responses API text/image workload uses cost-sensitive GPT-6 Luna
# with explicit medium reasoning by default. Each workload remains independently
# overridable for local latency, cost, or model-access constraints.
# VISION_MODEL must support input-image detail="original"; verify replacements
# with the live model-migration checks in docs/verification.md.
# https://developers.openai.com/api/docs/models/gpt-6-luna
# https://developers.openai.com/api/docs/guides/images-vision#choose-an-image-detail-level
VISION_MODEL=gpt-6-luna
PROGRESS_REASONING_EFFORT=medium
AGENT_VISION_MODEL=gpt-6-luna
AGENT_REASONING_EFFORT=medium
TEXT_MODEL=gpt-6-luna
TEXT_REASONING_EFFORT=medium

# --- Text-to-speech ---
# "openai" = OpenAI TTS API (needs internet and API billing)
# "pyttsx3" = installed Windows SAPI5 voice (synthesis/playback stay local)
TTS_ENGINE=openai
# Luna cannot replace this dedicated audio-output model because Luna returns text.
# https://developers.openai.com/api/docs/models/gpt-6-luna
# OpenAI TTS model/voice: https://developers.openai.com/api/docs/guides/text-to-speech
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# --- Monitoring cadence ---
# Fixed delay after a completed productivity tick (300 = 5 minutes)
CAPTURE_INTERVAL_S=300
# Maximum recent captures retained (minimum 2); comparison begins with capture 2
PROGRESS_WINDOW_CAPTURES=5
# Fixed delay after a completed enforcement tick
KILL_INTERVAL_S=3
# Fixed delay after each agent-watch tick, including an ineligible skipped tick
AGENT_CHECK_INTERVAL_S=60

# --- Break allowances ---
# Daily cap on social-media break minutes
DAILY_SOCIAL_CAP_MIN=120

# --- Web UI ---
UI_PORT=5000
