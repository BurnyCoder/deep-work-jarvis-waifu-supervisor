# Batch files must keep CRLF endings for cmd.exe (goto/label parsing quirks)
# https://git-scm.com/docs/gitattributes#_eol
*.bat text eol=crlf

# PDF reports contain byte offsets; preserve their exact bytes across checkouts.
# binary disables text conversion, text diffs, and text merging:
# https://git-scm.com/docs/gitattributes#_using_macro_attributes
reports/*.pdf binary
